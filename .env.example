# .env.example
# Copy to .env and fill in. Never commit .env.

# Expo app (public, safe for the client bundle)
# Hosted project: Dashboard > Project Settings > API. The anon key is public; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge Functions only (server-side secret, set with `supabase secrets set` when deployed)
OPENROUTER_API_KEY=
