# .env.example
# Copy to .env and fill in. Never commit .env.

# Web app (public, bundled into the site by Vite)
# Hosted project: Dashboard > Project Settings > API. The anon key is public; RLS protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Edge Functions only (server-side secret, set with `supabase secrets set` when deployed)
OPENROUTER_API_KEY=
