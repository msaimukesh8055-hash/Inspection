# .env.example
# Copy to .env and fill in. Never commit .env.

# Expo app (public, safe for the client bundle)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge Functions only (server-side secret, set with `supabase secrets set` when deployed)
OPENROUTER_API_KEY=
